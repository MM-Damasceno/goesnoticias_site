---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { CATEGORIAS, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const destaque = posts[0];
const recentes = posts.slice(1, 7);
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}
			.destaque {
				display: block;
				text-decoration: none;
				margin-bottom: 3rem;
			}
			.destaque img {
				width: 100%;
				border-radius: 12px;
				margin-bottom: 1rem;
			}
			.rotulo {
				margin: 0;
				font-size: 0.8em;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: rgb(var(--gray));
			}
			.destaque h1 {
				font-size: 2.2em;
				margin: 0.25rem 0 0.5rem;
			}
			.resumo {
				margin: 0 0 0.5rem;
				color: rgb(var(--gray-dark));
			}
			.data {
				margin: 0;
				font-size: 0.9em;
				color: rgb(var(--gray));
			}
			.grade {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
				gap: 2rem;
				list-style: none;
				margin: 1rem 0 2rem;
				padding: 0;
			}
			.grade a {
				display: block;
				text-decoration: none;
			}
			.grade img {
				width: 100%;
				height: auto;
				border-radius: 8px;
				margin-bottom: 0.5rem;
			}
			.grade h3 {
				font-size: 1.2em;
				margin: 0;
			}
			.destaque:hover h1,
			.grade a:hover h3 {
				color: var(--accent);
			}
			.ver-todas {
				font-weight: 700;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			{destaque ? (
				<a class="destaque" href={`/blog/${destaque.id}/`}>
					{destaque.data.heroImage && (
						<Image width={960} height={480} src={destaque.data.heroImage} alt="" />
					)}
					<p class="rotulo">Destaque · {CATEGORIAS[destaque.data.category]}</p>
					<h1>{destaque.data.title}</h1>
					<p class="resumo">{destaque.data.description}</p>
					<p class="data"><FormattedDate date={destaque.data.pubDate} /></p>
				</a>
			) : (
				<p>Ainda não há notícias publicadas.</p>
			)}

			{recentes.length > 0 && (
				<section>
					<h2>Últimas notícias</h2>
					<ul class="grade">
						{recentes.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && (
										<Image width={480} height={270} src={post.data.heroImage} alt="" />
									)}
									<p class="rotulo">{CATEGORIAS[post.data.category]}</p>
									<h3>{post.data.title}</h3>
									<p class="data"><FormattedDate date={post.data.pubDate} /></p>
								</a>
							</li>
						))}
					</ul>
					<a class="ver-todas" href="/blog">Ver todas as notícias →</a>
				</section>
			)}
		</main>
		<Footer />
	</body>
</html>