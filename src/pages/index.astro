---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { CATEGORIAS, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getNoticias, urlFor } from '../lib/sanity';

const posts = await getNoticias();
const destaque = posts[0];
const recentes = posts.slice(1, 7);
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}
			.destaque {
				display: block;
				text-decoration: none;
				margin-bottom: 3rem;
			}
			.destaque img {
				width: 100%;
				border-radius: 12px;
				margin-bottom: 1rem;
			}
			.rotulo {
				margin: 0;
				font-size: 0.8em;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: rgb(var(--gray));
			}
			.destaque h1 {
				font-size: 2.2em;
				margin: 0.25rem 0 0.5rem;
			}
			.resumo {
				margin: 0 0 0.5rem;
				color: rgb(var(--gray-dark));
			}
			.data {
				margin: 0;
				font-size: 0.9em;
				color: rgb(var(--gray));
			}
			.grade {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
				gap: 2rem;
				list-style: none;
				margin: 1rem 0 2rem;
				padding: 0;
			}
			.grade a {
				display: block;
				text-decoration: none;
			}
			.grade img {
				width: 100%;
				height: auto;
				border-radius: 8px;
				margin-bottom: 0.5rem;
			}
			.grade h3 {
				font-size: 1.2em;
				margin: 0;
			}
			.destaque:hover h1,
			.grade a:hover h3 {
				color: var(--accent);
			}
			.ver-todas {
				font-weight: 700;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			{destaque ? (
				<a class="destaque" href={`/blog/${destaque.slug}/`}>
					{destaque.heroImage && (
						<img
							src={urlFor(destaque.heroImage).width(960).height(480).auto('format').url()}
							alt={destaque.heroImage.alt ?? ''}
						/>
					)}
					<p class="rotulo">Destaque · {CATEGORIAS[destaque.category as keyof typeof CATEGORIAS]}</p>
					<h1>{destaque.title}</h1>
					<p class="resumo">{destaque.description}</p>
					<p class="data"><FormattedDate date={new Date(destaque.pubDate)} /></p>
				</a>
			) : (
				<p>Ainda não há notícias publicadas.</p>
			)}

			{recentes.length > 0 && (
				<section>
					<h2>Últimas notícias</h2>
					<ul class="grade">
						{recentes.map((post: any) => (
							<li>
								<a href={`/blog/${post.slug}/`}>
									{post.heroImage && (
										<img
											src={urlFor(post.heroImage).width(480).height(270).auto('format').url()}
											alt={post.heroImage.alt ?? ''}
										/>
									)}
									<p class="rotulo">{CATEGORIAS[post.category as keyof typeof CATEGORIAS]}</p>
									<h3>{post.title}</h3>
									<p class="data"><FormattedDate date={new Date(post.pubDate)} /></p>
								</a>
							</li>
						))}
					</ul>
					<a class="ver-todas" href="/blog">Ver todas as notícias →</a>
				</section>
			)}
		</main>
		<Footer />
	</body>
</html>