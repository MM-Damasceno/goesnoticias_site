---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { CATEGORIAS, SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { getNoticias, urlFor } from '../../lib/sanity';

const posts = await getNoticias();
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<BaseHead title={`Todas as notícias | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}
			.grade {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
				gap: 2rem;
				list-style: none;
				margin: 1.5rem 0;
				padding: 0;
			}
			.grade a {
				display: block;
				text-decoration: none;
			}
			.grade img {
				width: 100%;
				height: auto;
				border-radius: 8px;
				margin-bottom: 0.5rem;
			}
			.rotulo {
				margin: 0;
				font-size: 0.8em;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: rgb(var(--gray));
			}
			.grade h3 {
				font-size: 1.2em;
				margin: 0;
			}
			.grade a:hover h3 {
				color: var(--accent);
			}
			.data {
				margin: 0;
				font-size: 0.9em;
				color: rgb(var(--gray));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Todas as notícias</h1>
			{posts.length > 0 ? (
				<ul class="grade">
					{posts.map((post: any) => (
						<li>
							<a href={`/blog/${post.slug}/`}>
								{post.heroImage && (
									<img
										src={urlFor(post.heroImage).width(480).height(270).auto('format').url()}
										alt={post.heroImage.alt ?? ''}
									/>
								)}
								<p class="rotulo">{CATEGORIAS[post.category as keyof typeof CATEGORIAS]}</p>
								<h3>{post.title}</h3>
								<p class="data"><FormattedDate date={new Date(post.pubDate)} /></p>
							</a>
						</li>
					))}
				</ul>
			) : (
				<p>Ainda não há notícias publicadas.</p>
			)}
		</main>
		<Footer />
	</body>
</html>